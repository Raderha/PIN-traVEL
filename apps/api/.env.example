PORT=4000
# dev: localhost + LAN IP(선택). 쉼표로 여러 출처 가능
# WEB_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
WEB_ORIGIN=http://localhost:5173
# API 바인드 (기본 0.0.0.0 — 같은 Wi‑Fi에서 접속)
# HOST=0.0.0.0
JWT_SECRET=dev-secret-change-me

# 일정 경로(Geocoding + Directions 15) — NCP 문서 표기 그대로(권장):
X-NCP-APIGW-API-KEY-ID=
X-NCP-APIGW-API-KEY=
# 대체 이름(동일 값): NCP_APIGW_API_KEY_ID / NCP_APIGW_API_KEY

# 선택: 출발지 문자열을 Gemini로 도로명 한 줄로 바꾼 뒤 지오코딩·Directions에 사용 (@google/genai)
# gemini_api_key=
# 또는 GEMINI_API_KEY=
# 기본 모델: gemini-2.5-pro. 덮어쓰기: GEMINI_MODEL=gemini-2.5-flash
# 사용 가능 목록: https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
